# Store as ops.env with mode 0600; keep the key in a separate secured vault too.
BACKUP_ENCRYPTION_KEY=BASE64_32_BYTE_RANDOM_KEY
# Full mongodump --oplog needs a backup-capable account and a replica set URI.
BACKUP_MONGO_URL=mongodb://backup-user:URL_ENCODED_PASSWORD@REPLICA_HOSTS/?replicaSet=rs0&authSource=admin&tls=true
# Supply RESTORE_MONGO_URL only for an isolated recovery instance.
# RESTORE_MONGO_URL=mongodb://isolated-recovery-host:27017/?replicaSet=recovery

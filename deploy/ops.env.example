# Save outside webroot with permissions 0600. Keep key separately in a vault.
BACKUP_ENCRYPTION_KEY=BASE64_32_BYTE_RANDOM_KEY
MYSQL_URL=mysql://bigmobile:URL_ENCODED_PASSWORD@127.0.0.1:3306/big_mobile
BACKUP_MYSQL_URL=mysql://backup_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/big_mobile

FROM python:3.12-alpine
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements-production.lock ./requirements.lock
RUN apk upgrade --no-cache && pip install --no-cache-dir --require-hashes -r requirements.lock && adduser -D -u 10001 app
COPY backend/ ./
RUN mkdir -p /data/uploads && chown -R app:app /app /data
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*"]

APP_ENV=production
APP_BASE_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
MYSQL_URL=mysql://bigmobile:URL_ENCODED_PASSWORD@127.0.0.1:3306/big_mobile
DB_TRANSACTIONS=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_HOURS=8
SEED_DEMO_DATA=false
FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/var/lib/big-mobile/uploads
MONITOR_TOKEN=replace-with-a-separate-random-monitor-secret
# S3 alternative: IAM/bucket credentials must only grant access to this bucket.
# FILE_STORAGE_BACKEND=s3
# S3_BUCKET=private-big-mobile
# S3_ENDPOINT_URL=https://s3.example.com
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=configure-on-server
# AWS_SECRET_ACCESS_KEY=configure-on-server
# S3_ENCRYPTION=AES256

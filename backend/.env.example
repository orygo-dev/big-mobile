MYSQL_URL=mysql://bigmobile:URL_ENCODED_PASSWORD@127.0.0.1:3306/big_mobile
JWT_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=false
DB_TRANSACTIONS=true
APP_ENV=development
# Development only: set SEED_DEMO_DATA=true to create demo accounts and sample data.
# EMERGENT_LLM_KEY and INTEGRATION_PROXY_URL configure the existing object storage provider.
# Choose local explicitly for development without the remote storage provider.
FILE_STORAGE_BACKEND=local
